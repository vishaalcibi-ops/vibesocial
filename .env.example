# ==============================================================================
# VibeSocial Environment Configuration
# ==============================================================================

# Backend Provider Toggle ('supabase' | 'firebase')
VITE_BACKEND_PROVIDER=firebase

# Firebase Configuration (Project ID: vibesocial-app-906a8)
# Found in: Firebase Console > Project Settings > General > Your Apps > VibeSocial Web
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=vibesocial-app-906a8.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vibesocial-app-906a8
VITE_FIREBASE_STORAGE_BUCKET=vibesocial-app-906a8.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Supabase Configuration (Preserved for rollback & dual-support)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
