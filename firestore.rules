rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isConversationMember(memberIds) {
      return isAuthenticated() && request.auth.uid in memberIds;
    }

    // Validates that an update to posts only modifies likeCount, commentCount, and/or updatedAt
    function isValidPostCounterUpdate() {
      let diff = request.resource.data.diff(resource.data);
      let onlyAllowedKeys = diff.affectedKeys().hasOnly(['likeCount', 'commentCount', 'updatedAt']);
      return onlyAllowedKeys &&
        request.resource.data.authorId == resource.data.authorId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.likeCount >= 0 &&
        request.resource.data.commentCount >= 0;
    }

    // Validates that an update to reels only modifies likeCount, commentCount, and/or updatedAt
    function isValidReelCounterUpdate() {
      let diff = request.resource.data.diff(resource.data);
      let onlyAllowedKeys = diff.affectedKeys().hasOnly(['likeCount', 'commentCount', 'updatedAt']);
      return onlyAllowedKeys &&
        request.resource.data.authorId == resource.data.authorId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.likeCount >= 0 &&
        request.resource.data.commentCount >= 0;
    }

    // =========================================================================
    // 1. USERS & PROFILES
    // Document path: /users/{userId}
    // Fields: id, username, full_name, bio, avatar_url, website, is_verified, created_at, updated_at
    // =========================================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) &&
        request.resource.data.id == userId;
      allow update: if isOwner(userId) &&
        request.resource.data.id == userId;
      allow delete: if false; // Profiles cannot be wiped by client

      // Followers Subcollection: /users/{userId}/followers/{followerId}
      match /followers/{followerId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }

      // Following Subcollection: /users/{userId}/following/{followedId}
      match /following/{followedId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }

      // Follow Requests (for Private Accounts): /users/{userId}/followRequests/{requesterId}
      match /followRequests/{requesterId} {
        allow read, write: if isAuthenticated();
      }

      // Blocked Users: /users/{userId}/blockedUsers/{blockedId}
      match /blockedUsers/{blockedId} {
        allow read, write: if isOwner(userId);
      }

      // Restricted Users: /users/{userId}/restrictedUsers/{restrictedId}
      match /restrictedUsers/{restrictedId} {
        allow read, write: if isOwner(userId);
      }

      // Saved Posts Subcollection (private to owner): /users/{userId}/savedPosts/{postId}
      match /savedPosts/{postId} {
        allow read, write: if isOwner(userId);
      }

      // Notifications Subcollection (private to recipient): /users/{userId}/notifications/{notificationId}
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isAuthenticated();
      }
    }

    // =========================================================================
    // 2. POSTS, LIKES & COMMENTS
    // Document path: /posts/{postId}
    // Fields: id, authorId, authorUsername, authorDisplayName, authorAvatarUrl,
    //         authorIsVerified, caption, location, mediaType, mediaUrl,
    //         createdAt, updatedAt, likeCount, commentCount
    // =========================================================================
    match /posts/{postId} {
      // Feed and posts are readable publicly so posts persist after refresh and before auth completes
      allow read: if true;

      allow create: if isAuthenticated() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.likeCount == 0 &&
        request.resource.data.commentCount == 0 &&
        request.resource.data.caption is string &&
        request.resource.data.caption.size() <= 2200 &&
        (request.resource.data.mediaType in ['text', 'image', 'video']);

      allow update: if isAuthenticated() && (
        // Author can update caption or location (authorId and createdAt immutable)
        (resource.data.authorId == request.auth.uid &&
          request.resource.data.authorId == resource.data.authorId &&
          request.resource.data.createdAt == resource.data.createdAt) ||
        // Authenticated users can atomically update likeCount or commentCount counters
        isValidPostCounterUpdate()
      );

      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;

      // Post Likes Subcollection: /posts/{postId}/likes/{userId}
      match /likes/{userId} {
        allow read: if isAuthenticated();
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      // Post Comments Subcollection: /posts/{postId}/comments/{commentId}
      // Fields: authorId, authorUsername, authorDisplayName, authorAvatarUrl, content, parentCommentId, createdAt
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 500;
        allow delete: if isAuthenticated() && (
          resource.data.authorId == request.auth.uid ||
          get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
        );
        allow update: if false; // Comments cannot be edited once posted
      }
    }

    // =========================================================================
    // 3. STORIES
    // Document path: /stories/{storyId}
    // Fields: id, authorId, authorUsername, authorDisplayName, authorAvatarUrl,
    //         authorIsVerified, mediaUrl, mediaType, caption, createdAt, expiresAt
    // =========================================================================
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.mediaUrl is string &&
        (request.resource.data.mediaType in ['image', 'video']);
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;

      // Story Views Subcollection: /stories/{storyId}/views/{viewerId}
      match /views/{viewerId} {
        allow read: if isAuthenticated();
        allow create, update: if isOwner(viewerId);
        allow delete: if isOwner(viewerId);
      }
    }

    // =========================================================================
    // 4. REELS
    // Document path: /reels/{reelId}
    // Fields: id, authorId, authorUsername, authorDisplayName, authorAvatarUrl,
    //         authorIsVerified, videoUrl, caption, audioTitle, likeCount, commentCount,
    //         createdAt, updatedAt
    // =========================================================================
    match /reels/{reelId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.videoUrl is string &&
        request.resource.data.likeCount == 0 &&
        request.resource.data.commentCount == 0;
      allow update: if isAuthenticated() && (
        (resource.data.authorId == request.auth.uid &&
          request.resource.data.authorId == resource.data.authorId &&
          request.resource.data.createdAt == resource.data.createdAt) ||
        isValidReelCounterUpdate()
      );
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;

      // Reel Likes Subcollection: /reels/{reelId}/likes/{userId}
      match /likes/{userId} {
        allow read: if true;
        allow create, delete: if isOwner(userId);
      }

      // Reel Comments Subcollection: /reels/{reelId}/comments/{commentId}
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 500;
        allow delete: if isAuthenticated() && (
          resource.data.authorId == request.auth.uid ||
          get(/databases/$(database)/documents/reels/$(reelId)).data.authorId == request.auth.uid
        );
        allow update: if false;
      }
    }

    // =========================================================================
    // 5. DIRECT CONVERSATIONS & MESSAGES
    // Document path: /conversations/{conversationId}
    // Fields: memberIds, is_group, createdAt, updatedAt
    // =========================================================================
    match /conversations/{conversationId} {
      allow get: if isAuthenticated() && (
        resource == null ||
        request.auth.uid in resource.data.memberIds ||
        ('participantIds' in resource.data && request.auth.uid in resource.data.participantIds)
      );
      allow list: if isAuthenticated() && (
        request.auth.uid in resource.data.memberIds ||
        ('participantIds' in resource.data && request.auth.uid in resource.data.participantIds)
      );
      allow create: if isAuthenticated() && (
        (request.auth.uid in request.resource.data.memberIds && request.resource.data.memberIds.size() >= 2) ||
        ('participantIds' in request.resource.data && request.auth.uid in request.resource.data.participantIds)
      );
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.memberIds ||
        ('participantIds' in resource.data && request.auth.uid in resource.data.participantIds)
      );
      allow delete: if false;

      // Messages Subcollection: /conversations/{conversationId}/messages/{messageId}
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds ||
          ('participantIds' in get(/databases/$(database)/documents/conversations/$(conversationId)).data &&
           request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds)
        );
        allow create: if isAuthenticated() &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.textContent is string &&
          request.resource.data.textContent.size() <= 1000 && (
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds ||
            ('participantIds' in get(/databases/$(database)/documents/conversations/$(conversationId)).data &&
             request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds)
          );
        allow delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
        allow update: if isAuthenticated() && (
          resource.data.senderId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read'])
        );
      }
    }

    // =========================================================================
    // 6. CONTENT & USER REPORTS
    // Document path: /reports/{reportId}
    // Fields: id, reporterId, targetId, targetType, reason, details, status, createdAt
    // =========================================================================
    match /reports/{reportId} {
      allow read: if false; // Private to admins
      allow create: if isAuthenticated() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.reason is string &&
        request.resource.data.targetId is string;
      allow update, delete: if false;
    }

    // =========================================================================
    // 7. NOTES (Instagram Ephemeral 24h Notes with Music)
    // Document path: /notes/{noteId}
    // Fields: id, userId, username, displayName, avatarUrl, text, audioTrack, createdAt, expiresAt
    // =========================================================================
    match /notes/{noteId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }
  }
}

